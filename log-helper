#!/usr/bin/env bash

readonly EXIT_RUNTIME_ERROR=1
readonly EXIT_CONFIG_ERROR=2

: "${LOG_TAG:=aos-unit}"

# Must match ConditionPathExists=/ExecCondition= in aos-unit-node@.service
readonly NODE_START_GATE="/run/aos-unit/allow-node-start"

# Informational message (stdout)
log() {
    printf '%s: %s\n' "$LOG_TAG" "$*" >&2
}

# Error message (stderr)
error() {
    printf '%s: ERROR: %s\n' "$LOG_TAG" "$*" >&2
}

# Multi-line error message (each line prefixed)
error_multi() {
    while IFS= read -r line; do
        printf '%s: ERROR: %s\n' "$LOG_TAG" "$line" >&2
    done
}

# Log error and exit.
# Usage:
#   die "message"
#   die EXIT_CONFIG_ERROR "message"
die() {
    local code=1
    if [[ ${1:-} =~ ^[0-9]+$ ]]; then
        code="$1"
        shift
    fi
    error "$*"
    exit "$code"
}

readonly UNIT_WAIT_INTERVAL=0.2

# Print "<LoadState> <ActiveState>" of a unit; return 1 if systemd could not
# be queried, so callers never mistake a D-Bus error for a state.
unit_state() {
    local out key value load="" active=""

    out="$(systemctl show -p LoadState -p ActiveState "$1" 2>/dev/null)" || return 1

    while IFS='=' read -r key value; do
        case "$key" in
            LoadState) load="$value" ;;
            ActiveState) active="$value" ;;
        esac
    done <<<"$out"

    [[ -n $load ]] || return 1
    printf '%s %s\n' "$load" "$active"
}

# Queue a stop without waiting for the job, so callers never block on
# systemd job ordering and several units can be stopped in parallel.
request_unit_stop() {
    systemctl stop --no-block "$1" >/dev/null 2>&1 || true
}

# For transient units only (systemd-run --collect): the name can be reused
# once systemd has garbage-collected the unit, i.e. LoadState=not-found.
# Returns 1 on timeout. Never exits and never touches the caller's traps.
wait_for_unit_unloaded() {
    local -r unit="$1"
    local -r timeout_s="$2"
    local -r deadline=$((SECONDS + timeout_s))
    local state=""

    if state="$(unit_state "$unit")" && [[ $state == not-found* ]]; then
        return 0
    fi

    log "Waiting for transient unit to unload: ${unit} (timeout ${timeout_s}s)"
    request_unit_stop "$unit"

    while ((SECONDS < deadline)); do
        sleep "$UNIT_WAIT_INTERVAL"
        state="$(unit_state "$unit")" || continue
        case "$state" in
            not-found*) return 0 ;;
            # A failed transient is only collected after reset-failed
            *" failed") systemctl reset-failed "$unit" >/dev/null 2>&1 || true ;;
        esac
    done

    error "Unit ${unit} did not unload within ${timeout_s}s (last state: ${state:-unknown})"
    return 1
}

# For units shipped as files only: they stay loaded after stopping, so
# ActiveState (inactive or failed) is the only signal. Never use LoadState.
# Returns 1 on timeout. Never exits and never touches the caller's traps.
wait_for_unit_inactive() {
    local -r unit="$1"
    local -r timeout_s="$2"
    local -r deadline=$((SECONDS + timeout_s))
    local state=""

    if state="$(unit_state "$unit")" && [[ $state == *" inactive" || $state == *" failed" ]]; then
        return 0
    fi

    log "Waiting for unit to stop: ${unit} (timeout ${timeout_s}s)"
    request_unit_stop "$unit"

    while ((SECONDS < deadline)); do
        sleep "$UNIT_WAIT_INTERVAL"
        state="$(unit_state "$unit")" || continue
        case "$state" in
            *" inactive" | *" failed") return 0 ;;
        esac
    done

    error "Unit ${unit} did not stop within ${timeout_s}s (last state: ${state:-unknown})"
    return 1
}

ip_to_int() {
    local IFS=.
    local -a ipp
    IFS=. read -r -a ipp <<<"$1"
    echo $(((10#${ipp[0]} << 24) + (10#${ipp[1]} << 16) + (10#${ipp[2]} << 8) + 10#${ipp[3]}))
}

int_to_ip() {
    local i="$1"
    echo "$(((i >> 24) & 255)).$(((i >> 16) & 255)).$(((i >> 8) & 255)).$((i & 255))"
}

net_int_from_ip_mask() {
    echo $(($1 & $2))
}

bcast_int_from_net_mask() {
    echo $(($1 | ((~$2) & 0xFFFFFFFF)))
}
